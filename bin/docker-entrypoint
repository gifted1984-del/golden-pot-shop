#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare

  # Seed the catalogue only on a brand-new persistent database. This keeps
  # later administrator changes intact across Render deploys.
  if [ "$(./bin/rails runner 'puts Product.exists? ? "present" : "empty"')" == "empty" ]; then
    ./bin/rails db:seed
  fi
fi

exec "${@}"
