<% content_for :title, "管理ダッシュボード V2 | 黄金堂" %>

<div class="admin-v2-shell">
  <aside class="admin-sidebar">
    <%= link_to "黄金堂", admin_dashboard_path, class: "wordmark" %>
    <p class="admin-version">ADMIN CONSOLE / V2</p>
    <nav aria-label="管理メニュー">
      <%= link_to admin_dashboard_path, class: "admin-nav-link is-active" do %><span>◈</span> 概要<% end %>
      <%= link_to admin_products_path, class: "admin-nav-link" do %><span>□</span> 商品管理<% end %>
      <%= link_to new_admin_product_path, class: "admin-nav-link" do %><span>＋</span> 商品を追加<% end %>
    </nav>
    <%= link_to products_path, class: "admin-store-link" do %>ストアを表示 <span aria-hidden="true">↗</span><% end %>
  </aside>

  <main class="admin-v2-main">
    <header class="admin-v2-header">
      <div><p class="eyebrow">STORE OVERVIEW</p><h1>今日の黄金堂</h1></div>
      <%= link_to "商品を追加", new_admin_product_path, class: "button button-primary" %>
    </header>

    <section class="admin-metrics" aria-label="店舗指標">
      <article><p>ALL VISITS</p><strong><%= number_with_delimiter(@visit_count) %></strong><span>トップページの表示回数</span></article>
      <article><p>COLLECTION</p><strong><%= @product_count %></strong><span>登録済みの商品</span></article>
      <article><p>GOLD</p><strong><%= @gold_count %></strong><span>金のコレクション</span></article>
      <article><p>SILVER</p><strong><%= @silver_count %></strong><span>銀のコレクション</span></article>
      <article><p>COPPER</p><strong><%= @copper_count %></strong><span>銅のコレクション</span></article>
    </section>

    <section class="admin-v2-panels">
      <article class="admin-v2-panel material-balance">
        <div class="panel-heading"><div><p class="eyebrow">INVENTORY MIX</p><h2>素材ごとの構成</h2></div><%= link_to "商品管理へ", admin_products_path, class: "text-link" %></div>
        <% total = [@product_count, 1].max %>
        <div class="material-bars">
          <% [["金", @gold_count, "gold"], ["銀", @silver_count, "silver"], ["銅", @copper_count, "copper"]].each do |label, count, color| %>
            <div class="material-bar"><div><span><%= label %></span><strong><%= count %> 点</strong></div><div class="bar-track"><i class="<%= color %>" style="width: <%= (count.to_f / total * 100).round %>%"></i></div></div>
          <% end %>
        </div>
      </article>

      <article class="admin-v2-panel admin-next-step">
        <p class="eyebrow">NEXT ACTION</p><h2>コレクションを
          <br>磨き上げる。</h2><p>商品情報、素材、サイズ、説明文を更新し、ストアの見せ方を整えます。</p>
        <%= link_to "商品を管理する →", admin_products_path, class: "button button-quiet" %>
      </article>
    </section>
  </main>
</div>
