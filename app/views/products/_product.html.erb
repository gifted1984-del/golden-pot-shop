<div id="<%= dom_id product %>">
  <div>
    <strong>Name:</strong>
    <%= product.name %>
  </div>

  <div>
    <strong>Material:</strong>
    <%= product.material %>
  </div>

  <div>
    <strong>Size:</strong>
    <%= product.size %>
  </div>

  <div>
    <strong>Price:</strong>
    <%= product.price %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= product.description %>
  </div>

</div>
