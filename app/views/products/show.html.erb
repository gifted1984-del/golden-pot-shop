<% content_for :title, "#{@product.name} | 黄金堂" %>

<main class="product-show-page">
  <nav class="detail-nav section-shell" aria-label="パンくず">
    <%= link_to "← コレクションへ戻る", products_path, class: "back-link" %>
    <span class="wordmark">黄金堂</span>
  </nav>

  <article class="product-show-card section-shell">
    <div class="product-show-image <%= product_size_class(@product, prefix: "detail-pot") %>">
      <div class="detail-glow" aria-hidden="true"></div>
      <%= image_tag product_image_filename(@product), class: "detail-pot-image", alt: @product.name %>
    </div>

    <div class="product-show-info">
      <p class="eyebrow"><%= @product.material %> / <%= @product.size %></p>
      <h1><%= @product.name %></h1>
      <p class="detail-price"><%= display_price(@product) %></p>
      <p class="detail-description"><%= @product.description %></p>
      <dl class="product-specs">
        <div><dt>素材</dt><dd><%= @product.material %></dd></div>
        <div><dt>サイズ</dt><dd><%= @product.size %></dd></div>
        <div><dt>状態</dt><dd>展示品</dd></div>
      </dl>
      <%= link_to checkout_path(product_id: @product.id), class: "button button-primary" do %>
        デモ購入フローへ <span aria-hidden="true">→</span>
      <% end %>
      <p class="demo-inline-note">これはポートフォリオ用のデモです。実際の購入・請求は行われません。</p>
      <%= link_to "コレクションへ戻る", products_path, class: "button button-quiet" %>
    </div>
  </article>
</main>
