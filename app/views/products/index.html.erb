<% content_for :title, "黄金堂 | Golden Pot Shop" %>

<div class="shop-page">
  <header class="hero" id="top">
    <nav class="site-nav" aria-label="メインナビゲーション">
      <%= link_to "黄金堂", products_path, class: "wordmark", aria: { label: "黄金堂 ホーム" } %>
      <div class="nav-links">
        <a href="#materials" class="nav-link">素材を知る</a>
        <a href="#catalogue" class="nav-link">コレクション</a>
      </div>
    </nav>

    <div class="hero-content">
      <p class="eyebrow">A STUDY IN METAL AND FORM</p>
      <h1>黄金堂</h1>
      <p class="hero-kicker">GOLDEN POT SHOP</p>
      <p class="hero-copy">金、銀、銅。静かな存在感を宿す、
        <br class="desktop-only">一点ものの壺を集めました。</p>
      <a href="#materials" class="button button-primary">光をたどる <span aria-hidden="true">↓</span></a>
    </div>

    <div class="hero-object" aria-hidden="true">
      <div class="hero-glow"></div>
      <%= image_tag "pot_gold.png", class: "hero-pot", alt: "" %>
    </div>

    <p class="hero-footnote">架空のポートフォリオサイトです。商品の購入はできません。</p>
  </header>

  <main>
    <section class="discovery-rail" aria-label="黄金堂の素材">
      <a href="#gold"><span>01</span> 金 <i aria-hidden="true">↘</i></a>
      <a href="#silver"><span>02</span> 銀 <i aria-hidden="true">↘</i></a>
      <a href="#copper"><span>03</span> 銅 <i aria-hidden="true">↘</i></a>
    </section>

    <section class="collection-intro section-shell">
      <div>
        <p class="eyebrow">THE COLLECTION</p>
        <h2>素材がつくる、光と余韻。</h2>
      </div>
      <p>素材、サイズ、そして空間との調和。あなたのための一品をお選びください。</p>
    </section>

    <section class="material-journey section-shell" id="materials" aria-labelledby="materials-heading">
      <div class="journey-heading">
        <p class="eyebrow">CHOOSE YOUR RADIANCE</p>
        <h2 id="materials-heading">惹かれる光から、
          <br>一品を見つける。</h2>
        <p>同じ形でも、素材が変われば空間に残す印象は変わります。気になる光をひとつ選んで、コレクションを巡ってください。</p>
      </div>

      <div class="material-stories">
        <article class="material-story story-gold" id="gold">
          <div class="story-copy">
            <p class="story-number">01 / GOLD</p>
            <h3>金</h3>
            <p>あたたかな輝きと、圧倒的な存在感。</p>
            <%= link_to products_path(material: "金", anchor: "catalogue"), class: "story-link" do %>金の壺を見る <span aria-hidden="true">→</span><% end %>
          </div>
          <%= image_tag "pot_gold.png", class: "story-pot", alt: "金の壺" %>
        </article>

        <article class="material-story story-silver" id="silver">
          <div class="story-copy">
            <p class="story-number">02 / SILVER</p>
            <h3>銀</h3>
            <p>静けさのなかで、凛とした輪郭を描く。</p>
            <%= link_to products_path(material: "銀", anchor: "catalogue"), class: "story-link" do %>銀の壺を見る <span aria-hidden="true">→</span><% end %>
          </div>
          <%= image_tag "pot_silver.png", class: "story-pot", alt: "銀の壺" %>
        </article>

        <article class="material-story story-copper" id="copper">
          <div class="story-copy">
            <p class="story-number">03 / COPPER</p>
            <h3>銅</h3>
            <p>時とともに深まる、豊かで穏やかな表情。</p>
            <%= link_to products_path(material: "銅", anchor: "catalogue"), class: "story-link" do %>銅の壺を見る <span aria-hidden="true">→</span><% end %>
          </div>
          <%= image_tag "pot_copper.png", class: "story-pot", alt: "銅の壺" %>
        </article>
      </div>
    </section>

    <section class="collection-prompt section-shell" aria-label="コレクションへの案内">
      <p class="eyebrow">YOUR NEXT DISCOVERY</p>
      <p>素材、サイズ、言葉から。
        <span>気になる一品へ。</span></p>
      <a href="#catalogue" class="round-cta" aria-label="商品一覧へ進む"><span aria-hidden="true">↓</span></a>
    </section>

    <section class="catalogue section-shell" id="catalogue" aria-labelledby="catalogue-heading">
      <h2 id="catalogue-heading" class="visually-hidden">商品一覧</h2>
      <%= form_with url: products_path, method: :get, class: "catalogue-filter", data: { turbo: false } do |form| %>
        <div class="filter-field filter-search">
          <%= form.label :query, "商品を探す" %>
          <%= form.search_field :query, value: @query, placeholder: "商品名・説明で検索", autocomplete: "off" %>
        </div>
        <div class="filter-field">
          <%= form.label :material, "素材" %>
          <%= form.select :material, Product::MATERIALS, { include_blank: "すべて" }, selected: @material %>
        </div>
        <div class="filter-field">
          <%= form.label :size, "サイズ" %>
          <%= form.select :size, Product::SIZES, { include_blank: "すべて" }, selected: @size %>
        </div>
        <div class="filter-actions">
          <%= form.submit "絞り込む", class: "button button-primary" %>
          <%= link_to "リセット", products_path, class: "button button-quiet" %>
        </div>
      <% end %>

      <div class="catalogue-summary" aria-live="polite">
        <p><strong><%= @products.count %></strong> 点のコレクション</p>
        <p class="visit-count">訪問 <%= number_with_delimiter(@visit.count) %> 回</p>
      </div>

      <% if @products.any? %>
        <div class="products-grid">
          <% @products.each do |product| %>
            <article class="product-card">
              <div class="product-visual <%= product_size_class(product) %>">
                <p class="material-chip"><span aria-hidden="true">✦</span> <%= product.material %></p>
                <%= image_tag product_image_filename(product), class: "pot-image", alt: product.name %>
              </div>
              <div class="product-card-body">
                <p class="product-meta"><%= product.material %> ／ <%= product.size %></p>
                <h3><%= product.name %></h3>
                <p class="price"><%= display_price(product) %></p>
                <p class="description"><%= product.description %></p>
                <%= link_to product_path(product), class: "product-link", aria: { label: "#{product.name}の詳細を見る" } do %>
                  詳細を見る <span aria-hidden="true">→</span>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <p class="eyebrow">NO RESULTS</p>
          <h3>条件に合う壺が見つかりませんでした。</h3>
          <p>検索語や絞り込み条件を変更して、もう一度お試しください。</p>
          <%= link_to "すべての商品を見る", products_path, class: "button button-primary" %>
        </div>
      <% end %>
    </section>
  </main>

  <footer class="site-footer section-shell">
    <div>
      <p class="wordmark">黄金堂</p>
      <p>GOLDEN POT SHOP — Portfolio Edition</p>
    </div>
    <a href="https://github.com/gifted1984-del/golden-pot-shop" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
  </footer>
</div>
