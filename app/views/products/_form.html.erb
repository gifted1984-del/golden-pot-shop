<%= form_with(model: product, class: "admin-product-form") do |form| %>

  <% if product.errors.any? %>
    <div class="form-errors">
      <h2>入力内容を確認してください</h2>

      <ul>
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "商品名" %>
    <%= form.text_field :name %>
  </div>

  <div class="form-group">
    <%= form.label :material, "素材" %>
    <%= form.select :material,
                    [["金", "金"], ["銀", "銀"], ["銅", "銅"]] %>
  </div>

  <div class="form-group">
    <%= form.label :size, "サイズ" %>
    <%= form.select :size,
                    [["大", "大"], ["中", "中"], ["小", "小"]] %>
  </div>

  <div class="form-group">
    <%= form.label :price, "価格（円）" %>
    <%= form.number_field :price %>
  </div>

  <div class="form-group">
    <%= form.label :description, "商品説明" %>
    <%= form.text_area :description, rows: 5 %>
  </div>

  <div class="form-actions">
    <%= form.submit product.persisted? ? "商品を更新" : "商品を登録",
                    class: "admin-primary-button" %>
  </div>

<% end %>